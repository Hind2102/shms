# Copy to .env and edit. No API keys or passwords are needed: all AI runs locally.

# AI detector used by the web app: yolo | ollama | mock
SHMS_DETECTOR=yolo

# YOLO (SH17 weights, downloaded by scripts/download_models.py)
# YOLOv9e passed the release gate. YOLOv8s is the faster fallback.
SHMS_YOLO_WEIGHTS=models/sh17_yolo9e.pt
SHMS_YOLO_CONF=0.35
# "" = auto, or cpu | mps (Apple silicon) | cuda:0
SHMS_YOLO_DEVICE=

# Ollama vision-language model (install Ollama, then: ollama pull qwen2.5vl:7b)
SHMS_OLLAMA_URL=http://localhost:11434
SHMS_OLLAMA_MODEL=qwen2.5vl:7b
SHMS_OLLAMA_PROMPT=v2
SHMS_OLLAMA_TIMEOUT_S=120

# Storage
SHMS_DATABASE_URL=sqlite:///shms.db
SHMS_UPLOAD_DIR=uploads

# Shift view for supervisors ("since start of shift"): 12-hour shifts, day shift starting at this local hour,
# and the site's offset from UTC (the database stores UTC). Project settings, not site rules.
SHMS_SHIFT_START_HOUR=6
SHMS_SITE_UTC_OFFSET_H=4

# Public demo (Hugging Face Space). Leave off for local use.
# SHMS_DEMO_MODE=1            # banner on every page, data wiped on every start; needs SHMS_SECRET_KEY and yolo
# SHMS_RATE_LIMIT_PER_MIN=30  # submissions per client IP per minute (0 = no limit)
